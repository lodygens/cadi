@startuml
start
partition "Droit à l'oubli" {
:Demande d'effacement par l'utilisateur;
if (Authentifié en tant qu'administrateur ?) then (oui)
    if (Identité du demandeur vérifiée ?) then (oui)
        :Effacement définitif des envois
        liés aux alertes de l'utilisateur;
        :Effacement définitif des alertes
        de l'utilisateur;
        :Effacement des sessions et
        jetons de connexion de l'utilisateur;
        :Effacement définitif du compte
        de l'utilisateur;
        :Confirmation par email
        à l'utilisateur;
    else (non)
        :Refus de la demande;
    endif
else (non)
    stop
endif
}
stop
@enduml
