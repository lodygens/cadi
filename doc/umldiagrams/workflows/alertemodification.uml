@startuml
start
partition "Modification d'une \nalerte" {
if (Authentifié ?) then (oui)
    if (L'utilisateur est propriétaire de l'alerte ?) then (oui)
        if (Au moins un critère ?) then (oui)
            :Modification de l'alerte
            dans la base de données;
        endif
    endif
else (non)
    stop
endif
}
stop
@enduml
