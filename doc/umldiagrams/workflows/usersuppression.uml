@startuml
start
partition "Suppression d'un \ncompte utilisateur" {
if (Authentifié ?) then (oui)
    if (L'utilisateur est propriétaire de la fiche ?) then (oui)
        if (Suppression confirmée ?) then (oui)
            :Effacement immédiat et définitif des alertes,
            emails d'alerte et envois de l'utilisateur;
            :Effacement des sessions et jetons de connexion;
            :Effacement du compte;
        endif
    endif
else (non)
    stop
endif
}
stop
@enduml