@startuml
start
partition "Collecte des \nrappels produit" {
note right
  tâche planifiée, quotidienne
end note
:Enregistrement de la collecte
(statut « en cours »);
:Calcul de la date de départ:
début de la dernière collecte réussie
moins la marge de recouvrement
(30 jours),
au plus tôt la date de lancement;
:Lecture page par page de l'open data
RappelConso (fiches nationales publiées
depuis la date de départ);
if (Lecture réussie ?) then (non)
    :Collecte « échouée »
    (écrite dans les traces);
    stop
endif
while (Fiche suivante ?) is (oui)
    if (Fiche RAPEX ?) then (oui)
        :Fiche ignorée;
    elseif (Numéro de fiche (numero_fiche)\ndéjà connu ?) then (oui)
        :Fiche ignorée, même republiée
        (un rappel n'est jamais modifié,
        aucune alerte);
    else (non)
        :Interprétation des textes libres
        (zone, distributeurs) et
        fusion de la marque;
        note right: éléments non reconnus\nsignalés dans les traces
        :Dans une seule transaction:
        création du rappel (avec sa marque),
        des données de référence manquantes
        (marque, produits par code-barres,
        famille, magasins), de ses liens
        (produits, enseignes, magasins,
        départements) et ajout aux
        rappels à traiter;
    endif
endwhile (non)
:Envoi des alertes pour tous
les rappels à traiter (y compris
ceux d'une collecte interrompue);
:Collecte « réussie »
(écrite dans les traces);
}
stop
@enduml
